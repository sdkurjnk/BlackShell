{
  "name": "@sdkurjnk/blackshell",
  "version": "0.0.0",
  "description": "Build-stage protection tool that seals critical code regions at the compiler IR level, communicating with the outside only by value.",
  "type": "module",
  "bin": {
    "blackshell": "dist/cli.js"
  },
  "files": [
    "dist/",
    "src/"
  ],
  "scripts": {
    "build:engine": "node -e \"require('fs').mkdirSync('build',{recursive:true})\" && g++ -std=c++17 -O2 -o build/blackshell-engine src/engine/main.cpp",
    "build:ts": "tsc",
    "build": "npm run build:engine && npm run build:ts",
    "pretest": "npm run build",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sdkurjnk/BlackShell.git"
  },
  "bugs": {
    "url": "https://github.com/sdkurjnk/BlackShell/issues"
  },
  "homepage": "https://github.com/sdkurjnk/BlackShell#readme",
  "keywords": [
    "obfuscation",
    "code-protection",
    "compiler",
    "ir",
    "cli"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
